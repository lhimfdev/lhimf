# Production domain (no trailing slash). Used for canonical URL, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact details (PLACEHOLDERS until you set them)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_MOBILE=
# Where order/contact submissions are POSTed as JSON (e.g. a Make/Zapier/n8n webhook or your own service).
# If empty, /api/orders returns 503 and the site shows "demo mode" - nothing is sent.
ORDER_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" to the webhook
ORDER_WEBHOOK_SECRET=
