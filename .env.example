# Public site settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_MOBILE=

# Existing Neon PostgreSQL database. Keep the real connection string only in .env.local / hosting secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin access (required to enable the admin login)
ADMIN_EMAIL=lhimf@gmail.com
# Generate with: node scripts/create-admin-password-hash.mjs
ADMIN_PASSWORD_HASH=
# Generate a random secret of at least 32 characters; example command for PowerShell:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Optional webhook if you intentionally forward submissions elsewhere
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
